# LLM Provider: "ollama" (local) | "mistral" (cloud API)
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral

# Mistral API (cloud) — set provider=mistral to use
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Groq (alternative cloud) — set provider=groq to use
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# n8n production engine (optional). When set, provider=ollama plans are routed
# through the n8n chat-trigger webhook (seventeen.json workflow MUST be Active,
# or use /webhook-test/ while the editor is in test-listen mode).
N8N_WEBHOOK_URL=http://localhost:5678/webhook/copilot-trigger